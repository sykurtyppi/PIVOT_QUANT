# Dependencies
node_modules/

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Data files — the entire data/ tree is regenerable artifacts: model
# binaries (*.pkl), runtime DBs (*.sqlite/*.duckdb), parquet exports,
# and research syncs that also contain .env credentials. Nothing under
# data/ is tracked, so ignore it wholesale (supersedes the old granular
# rules that missed data/air_research_sync, data/t9_*, data/model_lab, etc.).
data/

# SQLite transient files
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# Local agent / model caches
.minimax/
.claude/worktrees/

# Test artifacts
test-results/

# Logs
logs/
backups/

# Stale data files
data/*.db

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Build artifacts
dist/
build/
coverage/

# Environment — never track credential files anywhere in the tree
.env
.env.local
*.env

# Package lock (optional - uncomment if you want to track it)
# package-lock.json
