# Report-only coverage configuration for the Python source packages.
#
# CI's "Python Coverage (report-only)" job uses this; it does NOT gate merges
# (no fail_under). Its purpose is to make untested Python surface visible.
#
# Run locally:
#   coverage run -m unittest discover -s tests/python -p "test_*.py"
#   coverage report
[run]
branch = True
# Inventory unexecuted files under namespace-package dirs (no __init__.py),
# e.g. scripts/gamma_signal/*, so they appear in the report at 0% rather than
# being silently omitted.
include_namespace_packages = True
source =
    ml
    server
    scripts
    services
omit =
    */__pycache__/*

[report]
show_missing = True
skip_covered = False
