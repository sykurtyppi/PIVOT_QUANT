# Report-only coverage configuration for the Python source packages.
#
# CI's "Python Coverage (report-only)" job uses this; it does NOT gate merges
# (no fail_under). Its purpose is to make untested Python surface visible.
#
# Run locally:
#   coverage run -m unittest discover -s tests/python -p "test_*.py"
#   coverage report
[run]
branch = True
source =
    ml
    server
    scripts
    services
omit =
    */__pycache__/*

[report]
show_missing = True
skip_covered = False
